<!--
    Almanac's icon: the wheel of the year, as in the sky info (SkyInfoDisplay.WheelIcon).
    A ring, a cross for the solstices and equinoxes, and a dot on the rim at Imbolc (top right).
    Adaptive icon canvas is 108 x 108; everything stays within the 66-wide safe circle
    in the middle (outermost point: 24 + 8 = 32 from the centre), so no mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Ring, radius 24 around (54,54) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="6"
        android:pathData="M54,30 A24,24 0 1,1 54,78 A24,24 0 1,1 54,30 Z" />
    <!-- Cross -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="5"
        android:pathData="M54,30 L54,78 M30,54 L78,54" />
    <!-- Dot, radius 8, centred on the rim at 45 degrees: (54 + 24 sin 45, 54 - 24 cos 45) -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M78.97,37.03 A8,8 0 1,1 62.97,37.03 A8,8 0 1,1 78.97,37.03 Z" />
</vector>
